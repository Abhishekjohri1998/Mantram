    "agenticArchitecture": {
        "corePipeline": "User Input → Orchestrator → Smart Router → AI Provider → RLHF Optimizer → Output",
        "keyComponents": [
            "Brand DNA Context Injection (every request includes brand context)",
            "State Machine Pipeline (multi-node processing)",
            "Self-Learning via RLHF (feedback → improved future outputs)"
        ],
        "agents": [
            {
                "name": "Orchestrator",
                "linesOfCode": 304,
                "responsibility": "Decomposes requests, delegates to agents, coordinates pipelines"
            },
            {
                "name": "Brand Scanner",
                "linesOfCode": 948,
                "responsibility": "Website scraping, logo/color/font/content extraction"
            },
            {
                "name": "Smart Language Router",
                "linesOfCode": 254,
                "responsibility": "Language detection → optimal model routing"
            },
            {
                "name": "RLHF Prompt Optimizer",
                "linesOfCode": 200,
                "responsibility": "Learns from user feedback, optimizes prompts"
            },
            {
                "name": "Product Matcher",
                "linesOfCode": 200,
                "responsibility": "Matches products to recommendations"
            },
            {
                "name": "Master Orchestrator",
                "linesOfCode": 150,
                "responsibility": "Higher-level coordination of multiple agents"
            },
            {
                "name": "Video Studio Nodes",
                "files": 5,
                "responsibility": "6-node pipeline for video generation"
            },
            {
                "name": "PM Intelligence",
                "files": 6,
                "responsibility": "Competitor research, strategy, web intelligence"
            }
        ],
        "selfLearningLoop": "Generation → User Feedback (like/dislike) → RLHF Optimizer → Improved Prompts → Better Future Outputs"
    },
